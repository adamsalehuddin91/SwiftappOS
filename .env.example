# PostgreSQL connection string
# For Coolify internal: postgresql://user:password@db-container-name:5432/dbname
# For Neon: postgresql://user:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://swiftappos:password@swiftappos-db:5432/swiftappos"

# Auth password (set this to protect access in production)
SWIFTAPP_PASSWORD="your-secure-password-here"

# Machine token for the Hermes agent (Authorization: Bearer ...).
# Minimum 32 characters — the app returns 503 rather than accept a short one.
# Generate with: openssl rand -hex 32
# Leave unset to disable the agent API entirely.
AGENT_API_TOKEN=""

# Optional. Signing key for browser session cookies. Defaults to
# SWIFTAPP_PASSWORD when unset.
#
# Set it if you want to end every logged-in session without changing the
# password you type: rotate this value and redeploy, and every outstanding
# cookie stops verifying. Sessions are stateless, so this is the revocation
# lever — logout only clears the browser's own copy.
#   openssl rand -hex 32
SESSION_SECRET=""
